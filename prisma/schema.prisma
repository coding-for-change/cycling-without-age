generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String                   @id
  name                 String                   @db.Text
  email                String
  emailVerified        Boolean                  @default(false)
  image                String?                  @db.Text
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  phoneNumber          String?
  phoneNumberVerified  Boolean?
  role                 String?                  @db.Text
  banned               Boolean?                 @default(false)
  banReason            String?                  @db.Text
  banExpires           DateTime?
  birthDate            DateTime?                @db.Date
  gender               Gender?
  locale               String?                  @db.VarChar(5)
  residence            Residence?
  address              String?                  @db.Text
  latitude             Float?
  longitude            Float?
  managesOthers        Boolean                  @default(false)
  notifyEmail          Boolean                  @default(false)
  notifyPush           Boolean                  @default(false)
  notifyChatPush       Boolean                  @default(true)
  notifyChatEmail      Boolean                  @default(true)
  consentSafetyAt      DateTime?
  consentDataAt        DateTime?
  passkeyPromptedAt    DateTime?
  pilotNextStepsSeenAt DateTime?
  onboardedAt          DateTime?
  createdByUserId      String?
  createdBy            User?                    @relation("createdUsers", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdUsers         User[]                   @relation("createdUsers")
  claimedAt            DateTime?
  helperName           String?                  @db.Text
  helperRelationship   String?                  @db.Text
  helperContact        String?                  @db.Text
  sessions             Session[]
  accounts             Account[]
  passkeys             Passkey[]
  members              Member[]
  invitations          Invitation[]
  countryAdminOf       CountryAdmin[]
  applications         ChapterApplication[]     @relation("applicant")
  decidedApplications  ChapterApplication[]     @relation("decider")
  passengers           Passenger[]              @relation("manages")
  passengerProfile     Passenger?               @relation("self")
  activityEvents       ActivityEvent[]          @relation("activitySubject")
  activityActions      ActivityEvent[]          @relation("activityActor")
  eventActions         Event[]                  @relation("eventActor")
  notifications        Notification[]           @relation("notificationRecipient")
  devices              Device[]
  conversationsCreated Conversation[]           @relation("conversationCreator")
  conversations        ConversationMember[]
  chatMessages         ChatMessage[]            @relation("chatMessageSender")
  chatReactions        ChatReaction[]
  rideAssignments      RideAssignment[]         @relation("rideAssignee")
  rideAssignmentsMade  RideAssignment[]         @relation("rideAssigner")
  rideRequests         RideRequest[]            @relation("rideRequester")
  rideRequestsDecided  RideRequest[]            @relation("rideRequestDecider")
  rideBookingsMade     RideRosterEntry[]        @relation("rideBooker")
  ridesCancelled       Ride[]                   @relation("rideCanceller")
  ridesCompleted       Ride[]                   @relation("rideCompleter")
  rideDebriefs         RideDebrief[]            @relation("rideDebriefs")
  rideLogEntries       RideLogEntry[]           @relation("rideLogActor")
  calendarFeed         CalendarFeed?
  uploadedFiles        StoredFile[]             @relation("fileUploader")
  reportedDamages      TrishawDamage[]          @relation("damageReporter")
  trainingEnrollments  TrainingEnrollment[]
  trainingProgress     TrainingLessonProgress[]
  trainingAttempts     TrainingQuizAttempt[]
  clearedDamages       TrishawDamage[]          @relation("damageClearer")
  trishawLogEntries    TrishawLogEntry[]        @relation("trishawLogActor")
  personProfile        PersonProfile?           @relation("profileOfUser")
  photoAgreements      PersonProfile[]          @relation("profilePhotoAgreedBy")
  healthConsentsGiven  PersonProfile[]          @relation("profileHealthConsentBy")
  pilotSteps           PilotStepTick[]          @relation("pilotStepOwner")
  careRequests         CareRequest[]            @relation("careRequestCaretaker")
  careRequestsMade     CareRequest[]            @relation("careRequestRequester")
  confirmedPilotSteps  PilotStepTick[]          @relation("pilotStepConfirmer")
  trainingExemptions   TrainingExemption[]      @relation("trainingExemptionOwner")
  grantedExemptions    TrainingExemption[]      @relation("trainingExemptionGranter")

  @@unique([email])
  @@unique([phoneNumber])
  @@index([createdByUserId])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?  @db.Text
  userAgent            String?  @db.Text
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy       String?  @db.Text
  activeOrganizationId String?  @db.Text

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @db.Text
  providerId            String    @db.Text
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String   @db.Text
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier(length: 191)])
  @@map("verification")
}

model Passkey {
  id           String    @id
  name         String?   @db.Text
  publicKey    String    @db.Text
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String    @db.Text
  counter      Int
  deviceType   String    @db.Text
  backedUp     Boolean
  transports   String?   @db.Text
  createdAt    DateTime?
  aaguid       String?   @db.Text

  @@index([userId])
  @@index([credentialID(length: 191)])
  @@map("passkey")
}

model Organization {
  id          String       @id @default(cuid())
  name        String       @db.Text
  slug        String
  logo        String?      @db.Text
  description String?      @db.Text
  createdAt   DateTime     @default(now())
  metadata    String?      @db.Text
  members     Member[]
  invitations Invitation[]

  countryId            String
  country              Country                  @relation(fields: [countryId], references: [id])
  city                 String                   @db.Text
  address              String?                  @db.Text
  careHomeName         String?                  @db.Text
  latitude             Float
  longitude            Float
  applications         ChapterApplication[]
  passengers           Passenger[]
  careRequests         CareRequest[]
  events               ActivityEvent[]
  domainEvents         Event[]
  serviceRadiusKm      Int                      @default(10)
  timeZone             String                   @db.VarChar(64)
  settings             ChapterSettings?
  conversations        Conversation[]
  trishawTypes         TrishawType[]
  trainingVideos       TrainingVideo[]
  trainingFamilies     TrainingCourseFamily[]
  trainingRequirements TrainingRequirement[]
  trainingExemptions   TrainingExemption[]
  rides                Ride[]
  storageSites         StorageLocationChapter[]
  ownedLocations       StorageLocation[]        @relation("ownedLocations")
  rideLocations        RideLocation[]
  operatingWindows     ChapterOperatingWindow[]
  closures             ChapterClosure[]
  rideRequests         RideRequest[]

  @@unique([slug])
  @@index([countryId])
  @@index([latitude, longitude])
  @@map("organization")
}

model Member {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @db.Text
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String       @db.Text
  role           String?      @db.Text
  status         String       @db.Text
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email(length: 191)])
  @@map("invitation")
}

enum ChapterRole {
  admin
  pilot
  passenger
}

enum ApplicationStatus {
  pending
  approved
  rejected
}

model Country {
  id        String   @id @default(cuid())
  name      String   @db.Text
  code      String   @db.VarChar(2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chapters             Organization[]
  admins               CountryAdmin[]
  trishawTypes         TrishawType[]
  trainingVideos       TrainingVideo[]
  trainingFamilies     TrainingCourseFamily[]
  trainingRequirements TrainingRequirement[]
  pools                StorageLocation[]

  @@unique([code])
  @@map("country")
}

model CountryAdmin {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  countryId String
  country   Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, countryId])
  @@index([countryId])
  @@map("country_admin")
}

model ChapterSettings {
  chapterId            String       @id
  chapter              Organization @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  notifyOnMemberJoined Boolean      @default(true)
  applicationAlertPush Boolean      @default(true)
  replyToEmail         String?      @db.VarChar(254)
  welcomeNote          String?      @db.Text
  postRideInstructions String?      @db.Text
  damageAlertPush      Boolean      @default(true)
  updatedAt            DateTime     @updatedAt
  bookingLeadTimeHours Int          @default(48)
  bookingHorizonDays   Int          @default(60)
  defaultRideMinutes   Int          @default(60)
  defaultStayMinutes   Int          @default(60)

  /// Pilots of the chapter may sign up for open rides themselves.
  pilotsMaySelfAssign    Boolean @default(true)
  /// Pilots a newly scheduled ride asks for.
  requiredPilotsDefault  Int     @default(1)
  /// How far ahead of a ride an understaffed ride is flagged, and a pilot can no longer withdraw.
  staffingCheckLeadHours Int     @default(48)

  /// Whether a Ride Request waits for an admin or becomes a ride when a trishaw is free.
  schedulingMethod             SchedulingMethod @default(scheduler)
  /// Admins get a push for each new Ride Request.
  requestAlertPush             Boolean          @default(true)
  /// How long before a ride its riders' accounts are reminded and asked to confirm their seat.
  riderReminderLeadMinutes     Int              @default(1440)
  /// How long before a ride its pilots are reminded, with the pickup pack.
  volunteerReminderLeadMinutes Int              @default(1440)
  /// How far ahead of a ride an empty roster is flagged for cancellation.
  demandCheckLeadHours         Int              @default(24)

  @@map("chapter_settings")
}

enum SchedulingMethod {
  scheduler
  auto
}

model ChapterOperatingWindow {
  id          String       @id @default(cuid())
  chapterId   String
  chapter     Organization @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  weekday     Int
  startMinute Int
  endMinute   Int

  @@unique([chapterId, weekday, startMinute])
  @@map("chapter_operating_window")
}

model ChapterClosure {
  id        String       @id @default(cuid())
  chapterId String
  chapter   Organization @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  date      DateTime     @db.Date
  reason    String?      @db.VarChar(200)
  createdAt DateTime     @default(now())

  @@unique([chapterId, date])
  @@map("chapter_closure")
}

model ChapterApplication {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation("applicant", fields: [userId], references: [id], onDelete: Cascade)
  chapterId       String
  chapter         Organization      @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  role            ChapterRole       @default(pilot)
  status          ApplicationStatus @default(pending)
  message         String?           @db.Text
  decidedByUserId String?
  decidedBy       User?             @relation("decider", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  decidedAt       DateTime?
  decisionNote    String?           @db.Text
  approvalSeenAt  DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([userId, chapterId])
  @@index([chapterId, status])
  @@index([decidedByUserId])
  @@map("chapter_application")
}

enum Gender {
  female
  male
  other
}

enum Residence {
  careHome
  home
}

model Passenger {
  id              String       @id @default(cuid())
  chapterId       String
  chapter         Organization @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  managedByUserId String
  managedBy       User         @relation("manages", fields: [managedByUserId], references: [id], onDelete: Restrict)
  userId          String?      @unique
  user            User?        @relation("self", fields: [userId], references: [id], onDelete: SetNull)

  firstName String   @db.Text
  lastName  String   @db.Text
  birthDate DateTime @db.Date
  gender    Gender

  /// Where a rider booked by someone else is picked up. A rider with their own
  /// account keeps it on their User.
  residence Residence?
  address   String?    @db.Text
  latitude  Float?
  longitude Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rideRoster   RideRosterEntry[]
  profile      PersonProfile?         @relation("profileOfPassenger")
  careRequests CareRequest[]
  rideRequests RideRequestPassenger[]
  activity     ActivityEvent[]

  rideLocationId      String?
  rideLocation        RideLocation? @relation(fields: [rideLocationId], references: [id], onDelete: SetNull)
  needsWheelchairBike Boolean       @default(false)
  note                String?       @db.Text

  @@index([chapterId])
  @@index([managedByUserId])
  @@index([rideLocationId])
  @@map("passenger")
}

enum CareRequestStatus {
  pending
  accepted
  declined
}

/// An admin asks someone who already has an account to look after a rider.
/// The rider only becomes a Passenger once that person accepts.
model CareRequest {
  id                String            @id @default(cuid())
  chapterId         String
  chapter           Organization      @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  caretakerUserId   String
  caretaker         User              @relation("careRequestCaretaker", fields: [caretakerUserId], references: [id], onDelete: Cascade)
  requestedByUserId String?
  requestedBy       User?             @relation("careRequestRequester", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  status            CareRequestStatus @default(pending)
  firstName         String            @db.Text
  lastName          String            @db.Text
  birthDate         DateTime          @db.Date
  gender            Gender
  residence         Residence?
  address           String?           @db.Text
  latitude          Float?
  longitude         Float?
  relationship      String?           @db.VarChar(40)
  helperName        String?           @db.VarChar(120)
  passengerId       String?
  passenger         Passenger?        @relation(fields: [passengerId], references: [id], onDelete: SetNull)
  createdAt         DateTime          @default(now())
  decidedAt         DateTime?

  @@index([caretakerUserId, status])
  @@index([chapterId, status])
  @@index([requestedByUserId])
  @@index([passengerId])
  @@map("care_request")
}

/// What a person tells the people they ride with. Belongs to exactly one of a
/// User (someone speaking for themself) or a managed Passenger (written on
/// their behalf by the manager) — enforced by a CHECK in the migration.
model PersonProfile {
  id                    String      @id @default(cuid())
  userId                String?     @unique
  user                  User?       @relation("profileOfUser", fields: [userId], references: [id], onDelete: Cascade)
  passengerId           String?     @unique
  passenger             Passenger?  @relation("profileOfPassenger", fields: [passengerId], references: [id], onDelete: Cascade)
  photoFileId           String?     @unique
  photo                 StoredFile? @relation("profilePhoto", fields: [photoFileId], references: [id], onDelete: SetNull)
  photoAgreedByUserId   String?
  photoAgreedBy         User?       @relation("profilePhotoAgreedBy", fields: [photoAgreedByUserId], references: [id], onDelete: SetNull)
  photoAgreedAt         DateTime?
  bio                   String?     @db.VarChar(200)
  interests             Json?
  customInterests       Json?
  prompts               Json?
  hideAge               Boolean     @default(false)
  accessibilityTags     Json?
  accessibilityNone     Boolean     @default(false)
  healthConsentAt       DateTime?
  healthConsentByUserId String?
  healthConsentBy       User?       @relation("profileHealthConsentBy", fields: [healthConsentByUserId], references: [id], onDelete: SetNull)
  setupDismissedAt      DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@index([photoAgreedByUserId])
  @@index([healthConsentByUserId])
  @@map("person_profile")
}

enum PilotStep {
  inPersonTraining
}

model PilotStepTick {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation("pilotStepOwner", fields: [userId], references: [id], onDelete: Cascade)
  step              PilotStep
  tickedAt          DateTime  @default(now())
  confirmedByUserId String?
  confirmedBy       User?     @relation("pilotStepConfirmer", fields: [confirmedByUserId], references: [id], onDelete: SetNull)
  confirmedAt       DateTime?

  @@unique([userId, step])
  @@index([confirmedByUserId])
  @@map("pilot_step_tick")
}

enum ActivityType {
  applicationSubmitted
  applicationApproved
  applicationRejected
  roleGranted
  roleRevoked
  memberRemoved
  emailSent
  countryAdminAppointed
  countryAdminRemoved
  accountCreated
  invited
  accountClaimed
  chapterCreated
  chapterUpdated
  chapterDeleted
  countryDeleted
  trainingPassed
  trainingExemptionGranted
  trainingExemptionRevoked
  inPersonTrainingConfirmed
  riderHandedOver
}

model ActivityEvent {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation("activitySubject", fields: [userId], references: [id], onDelete: Cascade)
  actorUserId String?
  actor       User?         @relation("activityActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  chapterId   String?
  chapter     Organization? @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  /// A rider the line is about, when it is one without an account of their own.
  passengerId String?
  passenger   Passenger?    @relation(fields: [passengerId], references: [id], onDelete: Cascade)
  type        ActivityType
  payload     Json?
  createdAt   DateTime      @default(now())

  @@index([userId, createdAt])
  @@index([chapterId, createdAt])
  @@index([passengerId, createdAt])
  @@map("activity_event")
}

model Event {
  id          String        @id @default(cuid())
  type        String
  payload     Json
  actorUserId String?
  actor       User?         @relation("eventActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  chapterId   String?
  chapter     Organization? @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  processedAt DateTime?

  notifications Notification[]

  @@index([processedAt, createdAt])
  @@index([actorUserId])
  @@index([chapterId, createdAt])
  @@map("event")
}

model Notification {
  id              String    @id @default(cuid())
  recipientUserId String
  recipient       User      @relation("notificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  eventId         String
  event           Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category        String    @db.VarChar(64)
  payload         Json
  href            String    @db.Text
  collapseKey     String?
  seenAt          DateTime?
  readAt          DateTime?
  createdAt       DateTime  @default(now())

  deliveries Delivery[]

  @@unique([eventId, recipientUserId])
  @@index([recipientUserId, createdAt])
  @@index([recipientUserId, seenAt])
  @@map("notification")
}

enum DeliveryChannel {
  email
  push
}

enum DeliveryStatus {
  pending
  sending
  sent
  failed
  skipped
}

model Delivery {
  id                String          @id @default(cuid())
  notificationId    String
  notification      Notification    @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  channel           DeliveryChannel
  status            DeliveryStatus  @default(pending)
  attempts          Int             @default(0)
  providerMessageId String?
  lastError         String?         @db.Text
  sentAt            DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([notificationId, channel])
  @@index([status, createdAt])
  @@map("delivery")
}

enum DevicePlatform {
  ios
  android
}

model Device {
  id         String         @id @default(cuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform   DevicePlatform
  token      String         @db.VarChar(512)
  lastSeenAt DateTime       @default(now())
  createdAt  DateTime       @default(now())

  @@unique([token])
  @@index([userId])
  @@index([lastSeenAt])
  @@map("device")
}

enum ConversationKind {
  direct
  group
}

enum ConversationOrigin {
  manual
  ride
}

enum ConversationMemberRole {
  owner
  member
}

enum ChatMessageKind {
  text
  system
}

model Conversation {
  id               String             @id @default(cuid())
  kind             ConversationKind
  origin           ConversationOrigin @default(manual)
  title            String?            @db.VarChar(120)
  chapterId        String?
  chapter          Organization?      @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  createdByUserId  String?
  createdBy        User?              @relation("conversationCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  directKey        String?            @unique
  dek              Bytes              @db.VarBinary(80)
  keyVersion       Int                @default(1)
  announcementOnly Boolean            @default(false)
  lastSeq          Int                @default(0)
  lastMessageId    String?
  lastMessageAt    DateTime?
  frozenAt         DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  /// The ride this conversation belongs to, when it is a ride chat.
  rideId String? @unique
  ride   Ride?   @relation(fields: [rideId], references: [id], onDelete: SetNull)

  members  ConversationMember[]
  messages ChatMessage[]

  @@index([chapterId, lastMessageAt])
  @@index([createdByUserId])
  @@map("conversation")
}

model ConversationMember {
  conversationId String
  conversation   Conversation           @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           ConversationMemberRole @default(member)
  joinedAt       DateTime               @default(now())
  lastReadSeq    Int                    @default(0)
  lastReadAt     DateTime?
  mutedUntil     DateTime?

  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_member")
}

model ChatMessage {
  id             String          @id @default(cuid())
  conversationId String
  conversation   Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  seq            Int
  senderId       String?
  sender         User?           @relation("chatMessageSender", fields: [senderId], references: [id], onDelete: SetNull)
  kind           ChatMessageKind @default(text)
  body           Bytes           @db.Blob
  meta           Json?
  replyToId      String?
  replyTo        ChatMessage?    @relation("chatMessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        ChatMessage[]   @relation("chatMessageReply")
  clientId       String?         @db.VarChar(64)
  editedAt       DateTime?
  deletedAt      DateTime?
  createdAt      DateTime        @default(now())

  reactions ChatReaction[]

  @@unique([conversationId, seq])
  @@unique([conversationId, senderId, clientId])
  @@index([createdAt])
  @@index([senderId])
  @@index([replyToId])
  @@map("chat_message")
}

model ChatReaction {
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String      @db.VarChar(32)
  createdAt DateTime    @default(now())

  @@id([messageId, userId, emoji])
  @@index([userId])
  @@map("chat_reaction")
}

enum RideModel {
  event
  pleasure
  functional
}

enum RideStatus {
  scheduled
  cancelled
  completed
}

enum RideRole {
  pilot
}

/// The Report 3 buckets: why a ride did not happen.
enum RideCancellationReason {
  weather
  rider
  facility
  volunteers
  equipment
  noRiders
  other
}

enum RideLogType {
  scheduled
  rescheduled
  edited
  cancelled
  trishawsChanged
  pilotAssigned
  pilotUnassigned
  riderBooked
  riderRemoved
  rosterReordered
  note
  seatConfirmed
  seatCancelled
  checkedIn
  checkInUndone
  walkUpAdded
  walkUpRemoved
  pilotNoShow
  completed
  reopened
  debriefed
}

/// Where a rider stands on a ride, from booking to the closed roster.
enum RosterAttendance {
  booked
  confirmed
  checkedIn
  completed
  noShow
  cancelled
}

/// Where a pilot stands on a ride; only a closed roster turns `signedUp` into `completed`.
enum AssignmentAttendance {
  signedUp
  completed
  noShow
}

enum TrishawStatus {
  active
  maintenance
  retired
}

enum StoredFileKind {
  typePhoto
  typeManual
  trishawPhoto
  entrancePhoto
  damagePhoto
  ridePhoto
  profilePhoto
  trainingAttachment
}

/// An object in the private bucket. Served only through `/api/files/[id]`,
/// which decides per kind who may read it.
model StoredFile {
  id               String         @id @default(cuid())
  key              String         @unique @db.VarChar(255)
  kind             StoredFileKind
  mime             String         @db.VarChar(100)
  size             Int
  uploadedByUserId String?
  uploadedBy       User?          @relation("fileUploader", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime       @default(now())

  typePhotos          TrishawType[]      @relation("typePhoto")
  typeManuals         TrishawType[]      @relation("typeManual")
  trishawPhotos       Trishaw[]          @relation("trishawPhoto")
  entrancePhotos      StorageLocation[]  @relation("entrancePhoto")
  damagePhotos        TrishawDamage[]    @relation("damagePhoto")
  typeGallery         TrishawTypePhoto[]
  trishawGallery      TrishawPhoto[]
  ridePhotos          RidePhoto[]
  profilePhoto        PersonProfile?     @relation("profilePhoto")
  trainingAttachments TrainingLesson[]   @relation("trainingAttachment")

  @@map("stored_file")
}

enum CatalogueScope {
  global
  country
  chapter
}

/**
 * A trishaw model — "Triobike Taxi", "VeloPlus". Super admins keep the global
 * catalogue, a country admin adds what only their country rides, and a chapter
 * can always add the one model nobody listed. A chapter sees global ∪ its
 * country ∪ its own. `scopeKey` folds scope and owner into one column so a name
 * is unique within its catalogue, which MySQL cannot express over nullable
 * owner columns.
 */
model TrishawType {
  id                   String             @id @default(cuid())
  name                 String             @db.VarChar(80)
  scope                CatalogueScope     @default(global)
  scopeKey             String             @default("global") @db.VarChar(200)
  countryId            String?
  country              Country?           @relation(fields: [countryId], references: [id], onDelete: Cascade)
  chapterId            String?
  chapter              Organization?      @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  description          String?            @db.Text
  seats                Int                @default(2)
  wheelchairAccessible Boolean            @default(false)
  photoFileId          String?
  photo                StoredFile?        @relation("typePhoto", fields: [photoFileId], references: [id], onDelete: SetNull)
  manualFileId         String?
  manual               StoredFile?        @relation("typeManual", fields: [manualFileId], references: [id], onDelete: SetNull)
  archivedAt           DateTime?
  createdByUserId      String?
  trishaws             Trishaw[]
  rideRequests         RideRequest[]
  photos               TrishawTypePhoto[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@unique([scopeKey, name])
  @@index([countryId])
  @@index([chapterId])
  @@map("trishaw_type")
}

enum StorageLocationKind {
  chapter
  pool
}

/**
 * Where trishaws are kept. A `chapter` location belongs to one chapter, which
 * gets a default one on creation. A `pool` belongs to a country: chapters of
 * that country ask to join with its code, a country admin decides, and every
 * approved chapter may schedule the trishaws parked there.
 */
model StorageLocation {
  id                  String              @id @default(cuid())
  kind                StorageLocationKind @default(chapter)
  name                String              @db.Text
  ownerChapterId      String?
  ownerChapter        Organization?       @relation("ownedLocations", fields: [ownerChapterId], references: [id], onDelete: Cascade)
  countryId           String?
  country             Country?            @relation(fields: [countryId], references: [id], onDelete: Cascade)
  isDefault           Boolean             @default(false)
  poolCode            String?             @unique @db.VarChar(16)
  membersMayManage    Boolean             @default(false)
  address             String?             @db.Text
  latitude            Float?
  longitude           Float?
  entrance            String?             @db.Text
  entrancePhotoFileId String?
  entrancePhoto       StoredFile?         @relation("entrancePhoto", fields: [entrancePhotoFileId], references: [id], onDelete: SetNull)
  accessCode          String?             @db.VarChar(64)
  accessNotes         String?             @db.Text
  returnInstructions  String?             @db.Text
  archivedAt          DateTime?

  chapters  StorageLocationChapter[]
  trishaws  Trishaw[]
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt

  @@index([ownerChapterId])
  @@index([countryId, kind])
  @@map("storage_location")
}

model StorageLocationChapter {
  id                String            @id @default(cuid())
  storageLocationId String
  storageLocation   StorageLocation   @relation(fields: [storageLocationId], references: [id], onDelete: Cascade)
  chapterId         String
  chapter           Organization      @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  status            ApplicationStatus @default(pending)
  requestedByUserId String?
  decidedByUserId   String?
  decidedAt         DateTime?
  decisionNote      String?           @db.Text
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([storageLocationId, chapterId])
  @@index([chapterId, status])
  @@map("storage_location_chapter")
}

model Trishaw {
  id                String          @id @default(cuid())
  name              String          @db.Text
  /// Stamped on the frame by the manufacturer. Set once, when the trishaw is added.
  frameNumber       String?         @unique @db.VarChar(64)
  typeId            String?
  type              TrishawType?    @relation(fields: [typeId], references: [id], onDelete: SetNull)
  status            TrishawStatus   @default(active)
  storageLocationId String
  storageLocation   StorageLocation @relation(fields: [storageLocationId], references: [id], onDelete: Cascade)
  photoFileId       String?
  photo             StoredFile?     @relation("trishawPhoto", fields: [photoFileId], references: [id], onDelete: SetNull)
  note              String?         @db.Text

  photos    TrishawPhoto[]
  rides     RideTrishaw[]
  damages   TrishawDamage[]
  log       TrishawLogEntry[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([storageLocationId, status])
  @@index([typeId])
  @@map("trishaw")
}

/// The model's gallery, in display order. `TrishawType.photoFileId` mirrors
/// position 0 so list views can show a cover without joining.
model TrishawTypePhoto {
  id        String      @id @default(cuid())
  typeId    String
  type      TrishawType @relation(fields: [typeId], references: [id], onDelete: Cascade)
  fileId    String      @unique
  file      StoredFile  @relation(fields: [fileId], references: [id], onDelete: Cascade)
  position  Int
  createdAt DateTime    @default(now())

  @@index([typeId, position])
  @@map("trishaw_type_photo")
}

/// Same as `TrishawTypePhoto`, for one trishaw; `Trishaw.photoFileId` is the cover.
model TrishawPhoto {
  id        String     @id @default(cuid())
  trishawId String
  trishaw   Trishaw    @relation(fields: [trishawId], references: [id], onDelete: Cascade)
  fileId    String     @unique
  file      StoredFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  position  Int
  createdAt DateTime   @default(now())

  @@index([trishawId, position])
  @@map("trishaw_photo")
}

/**
 * A damage or flaw on one trishaw. A grounding damage takes the trishaw out of
 * scheduling until an admin clears it; clearing always carries a sentence,
 * because "fixed" and "unjustified" are different stories in the history.
 */
model TrishawDamage {
  id               String      @id @default(cuid())
  trishawId        String
  trishaw          Trishaw     @relation(fields: [trishawId], references: [id], onDelete: Cascade)
  rideId           String?
  ride             Ride?       @relation(fields: [rideId], references: [id], onDelete: SetNull)
  reportedByUserId String?
  reportedBy       User?       @relation("damageReporter", fields: [reportedByUserId], references: [id], onDelete: SetNull)
  description      String      @db.Text
  photoFileId      String?
  photo            StoredFile? @relation("damagePhoto", fields: [photoFileId], references: [id], onDelete: SetNull)
  grounding        Boolean     @default(false)
  reportedAt       DateTime    @default(now())
  clearedAt        DateTime?
  clearedByUserId  String?
  clearedBy        User?       @relation("damageClearer", fields: [clearedByUserId], references: [id], onDelete: SetNull)
  clearNote        String?     @db.Text

  @@index([trishawId, clearedAt])
  @@index([rideId])
  @@map("trishaw_damage")
}

enum TrishawLogType {
  created
  statusChanged
  moved
  note
  damageReported
  damageCleared
}

model TrishawLogEntry {
  id          String         @id @default(cuid())
  trishawId   String
  trishaw     Trishaw        @relation(fields: [trishawId], references: [id], onDelete: Cascade)
  actorUserId String?
  actor       User?          @relation("trishawLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  type        TrishawLogType
  payload     Json?
  createdAt   DateTime       @default(now())

  @@index([trishawId, createdAt])
  @@map("trishaw_log_entry")
}

model Ride {
  id        String       @id @default(cuid())
  chapterId String
  chapter   Organization @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  model     RideModel    @default(event)
  status    RideStatus   @default(scheduled)

  title       String? @db.VarChar(120)
  description String? @db.Text
  capacity    Int?

  startsAt DateTime
  endsAt   DateTime

  locationName    String? @db.Text
  locationAddress String? @db.Text
  latitude        Float?
  longitude       Float?

  destinationName      String? @db.Text
  destinationAddress   String? @db.Text
  destinationLatitude  Float?
  destinationLongitude Float?

  returnLegOfId String? @unique
  returnLegOf   Ride?   @relation("roundTrip", fields: [returnLegOfId], references: [id], onDelete: SetNull)
  returnLeg     Ride?   @relation("roundTrip")

  /// Pilots the ride needs; staffing compares the assignments against it.
  requiredPilots Int     @default(1)
  /// What the pilots should know before they set off.
  note           String? @db.Text
  /// Shared by every ride of a recurring series, once recurrence exists.
  seriesId       String?

  /// An event ride the chapter's riders see and can book a seat on themselves.
  announced         Boolean   @default(false)
  /// Set the first time the event is announced, so its riders are told once.
  announcedAt       DateTime?
  /// Set once the staffing check has flagged the ride, so it is flagged only once.
  staffingCheckedAt DateTime?

  /// Each set in the same transaction as the reminder or flag it records, so a retried sweep sends nothing twice.
  riderReminderSentAt     DateTime?
  volunteerReminderSentAt DateTime?
  demandCheckedAt         DateTime?

  /// The moment the roster was closed (lifecycle 6D), which is when the ride counts.
  completedAt       DateTime?
  completedByUserId String?
  completedBy       User?     @relation("rideCompleter", fields: [completedByUserId], references: [id], onDelete: SetNull)

  cancelledAt            DateTime?
  cancellationReasonCode RideCancellationReason?
  cancellationNote       String?                 @db.Text
  cancelledByUserId      String?
  cancelledBy            User?                   @relation("rideCanceller", fields: [cancelledByUserId], references: [id], onDelete: SetNull)

  trishaws    RideTrishaw[]
  assignments RideAssignment[]
  roster      RideRosterEntry[]
  damages     TrishawDamage[]
  log         RideLogEntry[]
  photos      RidePhoto[]
  debriefs    RideDebrief[]

  conversation Conversation?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rideLocationId String?
  rideLocation   RideLocation? @relation(fields: [rideLocationId], references: [id], onDelete: SetNull)

  request RideRequest?

  @@index([chapterId, startsAt])
  @@index([status, startsAt])
  @@index([seriesId])
  @@index([cancelledByUserId])
  @@index([completedByUserId])
  @@index([rideLocationId, startsAt])
  @@map("ride")
}

enum RideLocationKind {
  careCenter
  residence
  publicPlace
  other
}

model RideLocation {
  id             String           @id @default(cuid())
  chapterId      String
  chapter        Organization     @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  kind           RideLocationKind @default(careCenter)
  name           String           @db.VarChar(160)
  address        String?          @db.Text
  latitude       Float?
  longitude      Float?
  contactName    String?          @db.VarChar(120)
  contactPhone   String?          @db.VarChar(40)
  contactEmail   String?          @db.VarChar(254)
  notes          String?          @db.Text
  typicalRideKm  Decimal?         @db.Decimal(6, 1)
  defaultMinutes Int?
  archivedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  rides        Ride[]
  passengers   Passenger[]
  rideRequests RideRequest[]

  @@index([chapterId, archivedAt])
  @@map("ride_location")
}

model RidePhoto {
  id        String     @id @default(cuid())
  rideId    String
  ride      Ride       @relation(fields: [rideId], references: [id], onDelete: Cascade)
  fileId    String
  file      StoredFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  position  Int
  createdAt DateTime   @default(now())

  @@unique([fileId])
  @@index([rideId, position])
  @@map("ride_photo")
}

/// A ride's own history, the way `TrishawLogEntry` is a trishaw's. The payload
/// holds ids, never names, so deleting a person removes them from it too.
model RideLogEntry {
  id          String      @id @default(cuid())
  rideId      String
  ride        Ride        @relation(fields: [rideId], references: [id], onDelete: Cascade)
  actorUserId String?
  actor       User?       @relation("rideLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  type        RideLogType
  payload     Json?
  createdAt   DateTime    @default(now())

  @@index([rideId, createdAt])
  @@index([actorUserId])
  @@map("ride_log_entry")
}

/**
 * One trishaw committed to one ride. A request may be for "a single trishaw or
 * multiple trishaws" (lifecycle 1C) and a Multiple Ride Event can involve
 * several at once, so the reservation is a row, not a column on `Ride`.
 * Trailers, wheelchair bikes and transport vehicles are reserved the same way
 * once they have models of their own.
 */
model RideTrishaw {
  id        String   @id @default(cuid())
  rideId    String
  ride      Ride     @relation(fields: [rideId], references: [id], onDelete: Cascade)
  trishawId String
  trishaw   Trishaw  @relation(fields: [trishawId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([rideId, trishawId])
  @@index([trishawId])
  @@map("ride_trishaw")
}

model RideAssignment {
  id               String               @id @default(cuid())
  rideId           String
  ride             Ride                 @relation(fields: [rideId], references: [id], onDelete: Cascade)
  userId           String
  user             User                 @relation("rideAssignee", fields: [userId], references: [id], onDelete: Cascade)
  role             RideRole             @default(pilot)
  attendance       AssignmentAttendance @default(signedUp)
  /// Null when the pilot signed up themselves.
  assignedByUserId String?
  assignedBy       User?                @relation("rideAssigner", fields: [assignedByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime             @default(now())

  @@unique([rideId, userId, role])
  @@index([userId])
  @@index([rideId])
  @@index([assignedByUserId])
  @@map("ride_assignment")
}

model RideRosterEntry {
  id             String           @id @default(cuid())
  rideId         String
  ride           Ride             @relation(fields: [rideId], references: [id], onDelete: Cascade)
  /// Null for a walk-up enrolled on the spot (lifecycle 6B), who has no rider record.
  passengerId    String?
  passenger      Passenger?       @relation(fields: [passengerId], references: [id], onDelete: Cascade)
  guestName      String?          @db.Text
  position       Int              @default(0)
  attendance     RosterAttendance @default(booked)
  confirmedAt    DateTime?
  cancelledAt    DateTime?
  checkedInAt    DateTime?
  bookedByUserId String?
  bookedBy       User?            @relation("rideBooker", fields: [bookedByUserId], references: [id], onDelete: SetNull)
  createdAt      DateTime         @default(now())

  @@unique([rideId, passengerId])
  @@index([passengerId])
  @@index([rideId, position])
  @@index([bookedByUserId])
  @@map("ride_roster_entry")
}

/// A pilot's report after a ride (story 31): one per pilot and ride, written
/// again as often as they like.
model RideDebrief {
  id         String   @id @default(cuid())
  rideId     String
  ride       Ride     @relation(fields: [rideId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation("rideDebriefs", fields: [userId], references: [id], onDelete: SetNull)
  distanceKm Decimal? @db.Decimal(7, 2)
  note       String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([rideId, userId])
  @@index([userId])
  @@map("ride_debrief")
}

/// A secret address a calendar app subscribes to (COD-182). Only `key` is kept;
/// the URL also carries an HMAC of it (`lib/crypto/feed-signature`), so a copy
/// of this table alone opens no feed. A new key is a new address, and every
/// app still holding the old one gets a 404 on its next poll.
model CalendarFeed {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  key           String    @unique @db.VarChar(32)
  lastFetchedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("calendar_feed")
}

enum TrainingVideoStatus {
  uploading
  queued
  processing
  ready
  failed
}

/**
 * A training video in the same global / country / chapter catalogue as trishaw
 * models. The original stays in the private bucket under `sourceKey` so it can
 * be transcoded again; the HLS renditions live in the public media bucket under
 * `training/v/<mediaKey>/<revision>/`, where the unguessable `mediaKey` is the
 * only thing standing between the CDN and a stranger. A retry bumps `revision`
 * so a stale CDN copy is never served for the new output.
 */
model TrainingVideo {
  id               String              @id @default(cuid())
  scope            CatalogueScope      @default(global)
  scopeKey         String              @default("global") @db.VarChar(200)
  countryId        String?
  country          Country?            @relation(fields: [countryId], references: [id], onDelete: Cascade)
  chapterId        String?
  chapter          Organization?       @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  language         String              @db.VarChar(16)
  title            String              @db.VarChar(160)
  description      String?             @db.Text
  status           TrainingVideoStatus @default(uploading)
  progress         Int                 @default(0)
  failureCode      String?             @db.VarChar(40)
  sourceKey        String              @unique @db.VarChar(255)
  sourceMime       String              @db.VarChar(100)
  sourceSize       BigInt
  uploadId         String?             @db.VarChar(1024)
  mediaKey         String              @unique @db.VarChar(32)
  revision         Int                 @default(1)
  durationSeconds  Float?
  width            Int?
  height           Int?
  renditions       Json?
  posterSeconds    Float?
  uploadedByUserId String?
  readyAt          DateTime?
  archivedAt       DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  lessons          TrainingLesson[]

  @@index([scopeKey, status])
  @@index([countryId])
  @@index([chapterId])
  @@index([status, updatedAt])
  @@map("training_video")
}

enum TrainingQuestionKind {
  single
  multiple
}

/// One course in several languages: "Basic Pilot Training" in English, German
/// and Danish is one family with three courses. Ownership sits on the family,
/// in the same catalogue scope as videos, so every language variant has the same
/// owner. Requirements and exemptions (Phase 3) point at the family, so passing
/// any language variant counts.
model TrainingCourseFamily {
  id              String                @id @default(cuid())
  scope           CatalogueScope        @default(global)
  scopeKey        String                @default("global") @db.VarChar(200)
  countryId       String?
  country         Country?              @relation(fields: [countryId], references: [id], onDelete: Cascade)
  chapterId       String?
  chapter         Organization?         @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  createdByUserId String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  courses         TrainingCourse[]
  requirements    TrainingRequirement[]
  exemptions      TrainingExemption[]

  @@index([scopeKey])
  @@index([countryId])
  @@index([chapterId])
  @@map("training_course_family")
}

/// One language variant of a family: ordered lessons and one final quiz. Hidden
/// from pilots until `publishedAt` is set; edits after that are live.
model TrainingCourse {
  id              String                @id @default(cuid())
  familyId        String
  family          TrainingCourseFamily  @relation(fields: [familyId], references: [id], onDelete: Cascade)
  language        String                @db.VarChar(16)
  title           String                @db.VarChar(160)
  summary         String?               @db.Text
  publishedAt     DateTime?
  createdByUserId String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  lessons         TrainingLesson[]
  enrollments     TrainingEnrollment[]
  attempts        TrainingQuizAttempt[]

  @@unique([familyId, language])
  @@map("training_course")
}

enum TrainingElementKind {
  lesson
  quiz
}

model TrainingLesson {
  id               String                   @id @default(cuid())
  courseId         String
  course           TrainingCourse           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  kind             TrainingElementKind      @default(lesson)
  position         Int
  title            String                   @db.VarChar(160)
  body             String?                  @db.Text
  videoId          String?
  video            TrainingVideo?           @relation(fields: [videoId], references: [id], onDelete: Restrict)
  attachmentFileId String?
  attachment       StoredFile?              @relation("trainingAttachment", fields: [attachmentFileId], references: [id], onDelete: SetNull)
  quizShuffle      Boolean                  @default(true)
  quizDrawCount    Int?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  progress         TrainingLessonProgress[]
  lastOf           TrainingEnrollment[]
  questions        TrainingQuestion[]
  attempts         TrainingQuizAttempt[]

  @@index([courseId, position])
  @@index([videoId])
  @@index([attachmentFileId])
  @@map("training_lesson")
}

model TrainingQuestion {
  id          String               @id @default(cuid())
  lessonId    String
  lesson      TrainingLesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  position    Int
  kind        TrainingQuestionKind @default(single)
  prompt      String               @db.Text
  explanation String?              @db.Text
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  options     TrainingOption[]

  @@index([lessonId, position])
  @@map("training_question")
}

model TrainingOption {
  id         String           @id @default(cuid())
  questionId String
  question   TrainingQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  position   Int
  text       String           @db.VarChar(500)
  correct    Boolean          @default(false)

  @@index([questionId, position])
  @@map("training_option")
}

/// A person's run through one course. `passedAt` is set once by the first
/// passing attempt and never cleared by later edits to the course.
model TrainingEnrollment {
  id             String                @id @default(cuid())
  userId         String
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId       String
  course         TrainingCourse        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  startedAt      DateTime              @default(now())
  lastActivityAt DateTime              @default(now())
  lastLessonId   String?
  lastLesson     TrainingLesson?       @relation(fields: [lastLessonId], references: [id], onDelete: SetNull)
  passedAt       DateTime?
  attemptCount   Int                   @default(0)
  attempts       TrainingQuizAttempt[]

  @@unique([userId, courseId])
  @@index([courseId])
  @@index([lastLessonId])
  @@map("training_enrollment")
}

/// How far someone watched a lesson. `furthestSeconds` only grows, and by no more
/// than the wall clock allows (`watch.ts`); `completedAt` sticks once set.
model TrainingLessonProgress {
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId        String
  lesson          TrainingLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  furthestSeconds Float          @default(0)
  positionSeconds Float          @default(0)
  heartbeatAt     DateTime       @default(now())
  completedAt     DateTime?
  createdAt       DateTime       @default(now())

  @@id([userId, lessonId])
  @@index([lessonId])
  @@map("training_lesson_progress")
}

/// One quiz attempt. `questionOrder` is the drawn questions with their option
/// order, fixed at start, so grading never depends on what the browser sent.
model TrainingQuizAttempt {
  id            String             @id @default(cuid())
  enrollmentId  String
  enrollment    TrainingEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  userId        String
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId      String
  course        TrainingCourse     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonId      String
  lesson        TrainingLesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  number        Int
  questionOrder Json
  startedAt     DateTime           @default(now())
  submittedAt   DateTime?
  answers       Json?
  correctCount  Int?
  total         Int
  passed        Boolean?

  @@unique([enrollmentId, lessonId, number])
  @@index([userId, courseId])
  @@index([courseId])
  @@index([lessonId])
  @@map("training_quiz_attempt")
}

enum TrainingExemptionReason {
  experienced
  manual
  migration
}

/// A family every pilot under the owner must pass (or be exempt from) before
/// riding. A chapter's effective set is global ∪ its country ∪ its own; a
/// chapter can add to what its country requires but never take away.
model TrainingRequirement {
  id              String               @id @default(cuid())
  familyId        String
  family          TrainingCourseFamily @relation(fields: [familyId], references: [id], onDelete: Cascade)
  scope           CatalogueScope       @default(global)
  scopeKey        String               @default("global") @db.VarChar(200)
  countryId       String?
  country         Country?             @relation(fields: [countryId], references: [id], onDelete: Cascade)
  chapterId       String?
  chapter         Organization?        @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  createdByUserId String?
  createdAt       DateTime             @default(now())

  @@unique([scopeKey, familyId])
  @@index([familyId])
  @@index([countryId])
  @@index([chapterId])
  @@map("training_requirement")
}

/// A person who needn't pass a family to ride: `familyKey` is "all" for a
/// blanket exemption (experienced pilots, the Phase 3 migration) or the
/// family's id. `chapterId` records where it was granted, for the audit trail.
model TrainingExemption {
  id              String                  @id @default(cuid())
  userId          String
  user            User                    @relation("trainingExemptionOwner", fields: [userId], references: [id], onDelete: Cascade)
  familyKey       String                  @db.VarChar(64)
  familyId        String?
  family          TrainingCourseFamily?   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  reason          TrainingExemptionReason
  grantedByUserId String?
  grantedBy       User?                   @relation("trainingExemptionGranter", fields: [grantedByUserId], references: [id], onDelete: SetNull)
  chapterId       String?
  chapter         Organization?           @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  grantedAt       DateTime                @default(now())

  @@unique([userId, familyKey])
  @@index([familyId])
  @@index([grantedByUserId])
  @@index([chapterId])
  @@map("training_exemption")
}

enum RideRequestStatus {
  pending
  scheduled
  declined
  withdrawn
}

/// Lifecycle phase 1: a rider, or the account booking for them, asks the
/// chapter for a ride. The chapter schedules it (the ride's way there is
/// `rideId`, the way back hangs off that ride) or declines it.
model RideRequest {
  id        String            @id @default(cuid())
  chapterId String
  chapter   Organization      @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  status    RideRequestStatus @default(pending)
  model     RideModel

  /// Null for a request taken without an account, once guest intake exists.
  requesterUserId String?
  requester       User?   @relation("rideRequester", fields: [requesterUserId], references: [id], onDelete: SetNull)
  contactName     String? @db.VarChar(120)
  contactPhone    String? @db.VarChar(40)
  contactEmail    String? @db.VarChar(254)

  rideLocationId  String?
  rideLocation    RideLocation? @relation(fields: [rideLocationId], references: [id], onDelete: SetNull)
  pickupName      String?       @db.VarChar(160)
  pickupAddress   String?       @db.Text
  pickupLatitude  Float?
  pickupLongitude Float?

  destinationName      String? @db.VarChar(160)
  destinationAddress   String? @db.Text
  destinationLatitude  Float?
  destinationLongitude Float?
  roundTrip            Boolean @default(true)

  /// The window asked for, as instants of the chapter's wall clock.
  requestedStartsAt DateTime
  requestedEndsAt   DateTime

  trishawTypeId String?
  trishawType   TrishawType? @relation(fields: [trishawTypeId], references: [id], onDelete: SetNull)
  note          String?      @db.Text

  decidedByUserId String?
  decidedBy       User?     @relation("rideRequestDecider", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  decidedAt       DateTime?
  decisionNote    String?   @db.Text

  /// The way there. A round trip's way back is that ride's `returnLeg`.
  rideId String? @unique
  ride   Ride?   @relation(fields: [rideId], references: [id], onDelete: SetNull)

  passengers RideRequestPassenger[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chapterId, status, requestedStartsAt])
  @@index([requesterUserId, createdAt])
  @@index([rideLocationId])
  @@index([trishawTypeId])
  @@index([decidedByUserId])
  @@map("ride_request")
}

model RideRequestPassenger {
  requestId   String
  request     RideRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  passengerId String
  passenger   Passenger   @relation(fields: [passengerId], references: [id], onDelete: Cascade)
  position    Int         @default(0)

  @@id([requestId, passengerId])
  @@index([passengerId])
  @@map("ride_request_passenger")
}
