generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String               @id
  name                 String               @db.Text
  email                String
  emailVerified        Boolean              @default(false)
  image                String?              @db.Text
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  phoneNumber          String?
  phoneNumberVerified  Boolean?
  role                 String?              @db.Text
  banned               Boolean?             @default(false)
  banReason            String?              @db.Text
  banExpires           DateTime?
  birthDate            DateTime?            @db.Date
  gender               Gender?
  locale               String?              @db.VarChar(5)
  residence            Residence?
  address              String?              @db.Text
  latitude             Float?
  longitude            Float?
  managesOthers        Boolean              @default(false)
  notifyEmail          Boolean              @default(false)
  notifyPush           Boolean              @default(false)
  notifyChatPush       Boolean              @default(true)
  notifyChatEmail      Boolean              @default(true)
  consentSafetyAt      DateTime?
  consentDataAt        DateTime?
  passkeyPromptedAt    DateTime?
  pilotNextStepsSeenAt DateTime?
  onboardedAt          DateTime?
  createdByUserId      String?
  createdBy            User?                @relation("createdUsers", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdUsers         User[]               @relation("createdUsers")
  claimedAt            DateTime?
  helperName           String?              @db.Text
  helperRelationship   String?              @db.Text
  helperContact        String?              @db.Text
  sessions             Session[]
  accounts             Account[]
  passkeys             Passkey[]
  members              Member[]
  invitations          Invitation[]
  countryAdminOf       CountryAdmin[]
  applications         ChapterApplication[] @relation("applicant")
  decidedApplications  ChapterApplication[] @relation("decider")
  passengers           Passenger[]          @relation("manages")
  passengerProfile     Passenger?           @relation("self")
  activityEvents       ActivityEvent[]      @relation("activitySubject")
  activityActions      ActivityEvent[]      @relation("activityActor")
  eventActions         Event[]              @relation("eventActor")
  notifications        Notification[]       @relation("notificationRecipient")
  devices              Device[]
  conversationsCreated Conversation[]       @relation("conversationCreator")
  conversations        ConversationMember[]
  chatMessages         ChatMessage[]        @relation("chatMessageSender")
  chatReactions        ChatReaction[]
  rideAssignments      RideAssignment[]
  calendarFeed         CalendarFeed?
  uploadedFiles        StoredFile[]         @relation("fileUploader")
  reportedDamages      TrishawDamage[]      @relation("damageReporter")
  clearedDamages       TrishawDamage[]      @relation("damageClearer")
  trishawLogEntries    TrishawLogEntry[]    @relation("trishawLogActor")

  @@unique([email])
  @@unique([phoneNumber])
  @@index([createdByUserId])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?  @db.Text
  userAgent            String?  @db.Text
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy       String?  @db.Text
  activeOrganizationId String?  @db.Text

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @db.Text
  providerId            String    @db.Text
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String   @db.Text
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier(length: 191)])
  @@map("verification")
}

model Passkey {
  id           String    @id
  name         String?   @db.Text
  publicKey    String    @db.Text
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String    @db.Text
  counter      Int
  deviceType   String    @db.Text
  backedUp     Boolean
  transports   String?   @db.Text
  createdAt    DateTime?
  aaguid       String?   @db.Text

  @@index([userId])
  @@index([credentialID(length: 191)])
  @@map("passkey")
}

model Organization {
  id          String       @id @default(cuid())
  name        String       @db.Text
  slug        String
  logo        String?      @db.Text
  description String?      @db.Text
  createdAt   DateTime     @default(now())
  metadata    String?      @db.Text
  members     Member[]
  invitations Invitation[]

  countryId       String
  country         Country                  @relation(fields: [countryId], references: [id])
  city            String                   @db.Text
  address         String?                  @db.Text
  careHomeName    String?                  @db.Text
  latitude        Float
  longitude       Float
  applications    ChapterApplication[]
  passengers      Passenger[]
  events          ActivityEvent[]
  domainEvents    Event[]
  serviceRadiusKm Int                      @default(10)
  timeZone        String                   @db.VarChar(64)
  settings        ChapterSettings?
  conversations   Conversation[]
  trishawTypes    TrishawType[]
  rides           Ride[]
  storageSites    StorageLocationChapter[]
  ownedLocations  StorageLocation[]        @relation("ownedLocations")

  @@unique([slug])
  @@index([countryId])
  @@index([latitude, longitude])
  @@map("organization")
}

model Member {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @db.Text
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String       @db.Text
  role           String?      @db.Text
  status         String       @db.Text
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email(length: 191)])
  @@map("invitation")
}

enum ChapterRole {
  admin
  pilot
  passenger
}

enum ApplicationStatus {
  pending
  approved
  rejected
}

model Country {
  id        String   @id @default(cuid())
  name      String   @db.Text
  code      String   @db.VarChar(2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chapters     Organization[]
  admins       CountryAdmin[]
  trishawTypes TrishawType[]
  pools        StorageLocation[]

  @@unique([code])
  @@map("country")
}

model CountryAdmin {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  countryId String
  country   Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, countryId])
  @@index([countryId])
  @@map("country_admin")
}

model ChapterSettings {
  chapterId            String       @id
  chapter              Organization @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  notifyOnMemberJoined Boolean      @default(true)
  applicationAlertPush Boolean      @default(true)
  replyToEmail         String?      @db.VarChar(254)
  welcomeNote          String?      @db.Text
  postRideInstructions String?      @db.Text
  damageAlertPush      Boolean      @default(true)
  updatedAt            DateTime     @updatedAt

  @@map("chapter_settings")
}

model ChapterApplication {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation("applicant", fields: [userId], references: [id], onDelete: Cascade)
  chapterId       String
  chapter         Organization      @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  role            ChapterRole       @default(pilot)
  status          ApplicationStatus @default(pending)
  message         String?           @db.Text
  decidedByUserId String?
  decidedBy       User?             @relation("decider", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  decidedAt       DateTime?
  decisionNote    String?           @db.Text
  approvalSeenAt  DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([userId, chapterId])
  @@index([chapterId, status])
  @@index([decidedByUserId])
  @@map("chapter_application")
}

enum Gender {
  female
  male
  other
}

enum Residence {
  careHome
  home
}

model Passenger {
  id              String       @id @default(cuid())
  chapterId       String
  chapter         Organization @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  managedByUserId String
  managedBy       User         @relation("manages", fields: [managedByUserId], references: [id], onDelete: Cascade)
  userId          String?      @unique
  user            User?        @relation("self", fields: [userId], references: [id], onDelete: SetNull)

  firstName String   @db.Text
  lastName  String   @db.Text
  birthDate DateTime @db.Date
  gender    Gender

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rideRoster RideRosterEntry[]

  @@index([chapterId])
  @@index([managedByUserId])
  @@map("passenger")
}

enum ActivityType {
  applicationSubmitted
  applicationApproved
  applicationRejected
  roleGranted
  roleRevoked
  memberRemoved
  emailSent
  countryAdminAppointed
  countryAdminRemoved
  accountCreated
  invited
  accountClaimed
  chapterCreated
  chapterUpdated
  chapterDeleted
  countryDeleted
}

model ActivityEvent {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation("activitySubject", fields: [userId], references: [id], onDelete: Cascade)
  actorUserId String?
  actor       User?         @relation("activityActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  chapterId   String?
  chapter     Organization? @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  type        ActivityType
  payload     Json?
  createdAt   DateTime      @default(now())

  @@index([userId, createdAt])
  @@index([chapterId, createdAt])
  @@map("activity_event")
}

model Event {
  id          String        @id @default(cuid())
  type        String
  payload     Json
  actorUserId String?
  actor       User?         @relation("eventActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  chapterId   String?
  chapter     Organization? @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  processedAt DateTime?

  notifications Notification[]

  @@index([processedAt, createdAt])
  @@index([actorUserId])
  @@index([chapterId, createdAt])
  @@map("event")
}

model Notification {
  id              String    @id @default(cuid())
  recipientUserId String
  recipient       User      @relation("notificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  eventId         String
  event           Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category        String    @db.VarChar(64)
  payload         Json
  href            String    @db.Text
  collapseKey     String?
  seenAt          DateTime?
  readAt          DateTime?
  createdAt       DateTime  @default(now())

  deliveries Delivery[]

  @@unique([eventId, recipientUserId])
  @@index([recipientUserId, createdAt])
  @@index([recipientUserId, seenAt])
  @@map("notification")
}

enum DeliveryChannel {
  email
  push
}

enum DeliveryStatus {
  pending
  sending
  sent
  failed
  skipped
}

model Delivery {
  id                String          @id @default(cuid())
  notificationId    String
  notification      Notification    @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  channel           DeliveryChannel
  status            DeliveryStatus  @default(pending)
  attempts          Int             @default(0)
  providerMessageId String?
  lastError         String?         @db.Text
  sentAt            DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([notificationId, channel])
  @@index([status, createdAt])
  @@map("delivery")
}

enum DevicePlatform {
  ios
  android
}

model Device {
  id         String         @id @default(cuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform   DevicePlatform
  token      String         @db.VarChar(512)
  lastSeenAt DateTime       @default(now())
  createdAt  DateTime       @default(now())

  @@unique([token])
  @@index([userId])
  @@index([lastSeenAt])
  @@map("device")
}

enum ConversationKind {
  direct
  group
}

enum ConversationOrigin {
  manual
  ride
}

enum ConversationMemberRole {
  owner
  member
}

enum ChatMessageKind {
  text
  system
}

model Conversation {
  id               String             @id @default(cuid())
  kind             ConversationKind
  origin           ConversationOrigin @default(manual)
  title            String?            @db.VarChar(120)
  chapterId        String?
  chapter          Organization?      @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  createdByUserId  String?
  createdBy        User?              @relation("conversationCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  directKey        String?            @unique
  dek              Bytes              @db.VarBinary(80)
  keyVersion       Int                @default(1)
  announcementOnly Boolean            @default(false)
  lastSeq          Int                @default(0)
  lastMessageId    String?
  lastMessageAt    DateTime?
  frozenAt         DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  members  ConversationMember[]
  messages ChatMessage[]

  @@index([chapterId, lastMessageAt])
  @@index([createdByUserId])
  @@map("conversation")
}

model ConversationMember {
  conversationId String
  conversation   Conversation           @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           ConversationMemberRole @default(member)
  joinedAt       DateTime               @default(now())
  lastReadSeq    Int                    @default(0)
  lastReadAt     DateTime?
  mutedUntil     DateTime?

  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_member")
}

model ChatMessage {
  id             String          @id @default(cuid())
  conversationId String
  conversation   Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  seq            Int
  senderId       String?
  sender         User?           @relation("chatMessageSender", fields: [senderId], references: [id], onDelete: SetNull)
  kind           ChatMessageKind @default(text)
  body           Bytes           @db.Blob
  meta           Json?
  replyToId      String?
  replyTo        ChatMessage?    @relation("chatMessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        ChatMessage[]   @relation("chatMessageReply")
  clientId       String?         @db.VarChar(64)
  editedAt       DateTime?
  deletedAt      DateTime?
  createdAt      DateTime        @default(now())

  reactions ChatReaction[]

  @@unique([conversationId, seq])
  @@unique([conversationId, senderId, clientId])
  @@index([createdAt])
  @@index([senderId])
  @@index([replyToId])
  @@map("chat_message")
}

model ChatReaction {
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String      @db.VarChar(32)
  createdAt DateTime    @default(now())

  @@id([messageId, userId, emoji])
  @@index([userId])
  @@map("chat_reaction")
}

enum RideModel {
  event
  pleasure
  functional
}

enum RideStatus {
  scheduled
  cancelled
  completed
}

enum RideRole {
  pilot
}

enum TrishawStatus {
  active
  maintenance
  retired
}

enum StoredFileKind {
  typePhoto
  typeManual
  trishawPhoto
  entrancePhoto
  damagePhoto
}

/// An object in the private bucket. Served only through `/api/files/[id]`,
/// which decides per kind who may read it.
model StoredFile {
  id               String         @id @default(cuid())
  key              String         @unique @db.VarChar(255)
  kind             StoredFileKind
  mime             String         @db.VarChar(100)
  size             Int
  uploadedByUserId String?
  uploadedBy       User?          @relation("fileUploader", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime       @default(now())

  typePhotos     TrishawType[]      @relation("typePhoto")
  typeManuals    TrishawType[]      @relation("typeManual")
  trishawPhotos  Trishaw[]          @relation("trishawPhoto")
  entrancePhotos StorageLocation[]  @relation("entrancePhoto")
  damagePhotos   TrishawDamage[]    @relation("damagePhoto")
  typeGallery    TrishawTypePhoto[]
  trishawGallery TrishawPhoto[]

  @@map("stored_file")
}

enum CatalogueScope {
  global
  country
  chapter
}

/**
 * A trishaw model — "Triobike Taxi", "VeloPlus". Super admins keep the global
 * catalogue, a country admin adds what only their country rides, and a chapter
 * can always add the one model nobody listed. A chapter sees global ∪ its
 * country ∪ its own. `scopeKey` folds scope and owner into one column so a name
 * is unique within its catalogue, which MySQL cannot express over nullable
 * owner columns.
 */
model TrishawType {
  id                   String             @id @default(cuid())
  name                 String             @db.VarChar(80)
  scope                CatalogueScope     @default(global)
  scopeKey             String             @default("global") @db.VarChar(200)
  countryId            String?
  country              Country?           @relation(fields: [countryId], references: [id], onDelete: Cascade)
  chapterId            String?
  chapter              Organization?      @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  description          String?            @db.Text
  seats                Int                @default(2)
  wheelchairAccessible Boolean            @default(false)
  photoFileId          String?
  photo                StoredFile?        @relation("typePhoto", fields: [photoFileId], references: [id], onDelete: SetNull)
  manualFileId         String?
  manual               StoredFile?        @relation("typeManual", fields: [manualFileId], references: [id], onDelete: SetNull)
  archivedAt           DateTime?
  createdByUserId      String?
  trishaws             Trishaw[]
  photos               TrishawTypePhoto[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@unique([scopeKey, name])
  @@index([countryId])
  @@index([chapterId])
  @@map("trishaw_type")
}

enum StorageLocationKind {
  chapter
  pool
}

/**
 * Where trishaws are kept. A `chapter` location belongs to one chapter, which
 * gets a default one on creation. A `pool` belongs to a country: chapters of
 * that country ask to join with its code, a country admin decides, and every
 * approved chapter may schedule the trishaws parked there.
 */
model StorageLocation {
  id                  String              @id @default(cuid())
  kind                StorageLocationKind @default(chapter)
  name                String              @db.Text
  ownerChapterId      String?
  ownerChapter        Organization?       @relation("ownedLocations", fields: [ownerChapterId], references: [id], onDelete: Cascade)
  countryId           String?
  country             Country?            @relation(fields: [countryId], references: [id], onDelete: Cascade)
  isDefault           Boolean             @default(false)
  poolCode            String?             @unique @db.VarChar(16)
  membersMayManage    Boolean             @default(false)
  address             String?             @db.Text
  latitude            Float?
  longitude           Float?
  entrance            String?             @db.Text
  entrancePhotoFileId String?
  entrancePhoto       StoredFile?         @relation("entrancePhoto", fields: [entrancePhotoFileId], references: [id], onDelete: SetNull)
  accessCode          String?             @db.VarChar(64)
  accessNotes         String?             @db.Text
  returnInstructions  String?             @db.Text
  archivedAt          DateTime?

  chapters  StorageLocationChapter[]
  trishaws  Trishaw[]
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt

  @@index([ownerChapterId])
  @@index([countryId, kind])
  @@map("storage_location")
}

model StorageLocationChapter {
  id                String            @id @default(cuid())
  storageLocationId String
  storageLocation   StorageLocation   @relation(fields: [storageLocationId], references: [id], onDelete: Cascade)
  chapterId         String
  chapter           Organization      @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  status            ApplicationStatus @default(pending)
  requestedByUserId String?
  decidedByUserId   String?
  decidedAt         DateTime?
  decisionNote      String?           @db.Text
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([storageLocationId, chapterId])
  @@index([chapterId, status])
  @@map("storage_location_chapter")
}

model Trishaw {
  id                String          @id @default(cuid())
  name              String          @db.Text
  /// Stamped on the frame by the manufacturer. Set once, when the trishaw is added.
  frameNumber       String?         @unique @db.VarChar(64)
  typeId            String?
  type              TrishawType?    @relation(fields: [typeId], references: [id], onDelete: SetNull)
  status            TrishawStatus   @default(active)
  storageLocationId String
  storageLocation   StorageLocation @relation(fields: [storageLocationId], references: [id], onDelete: Cascade)
  photoFileId       String?
  photo             StoredFile?     @relation("trishawPhoto", fields: [photoFileId], references: [id], onDelete: SetNull)
  note              String?         @db.Text

  photos    TrishawPhoto[]
  rides     RideTrishaw[]
  damages   TrishawDamage[]
  log       TrishawLogEntry[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([storageLocationId, status])
  @@index([typeId])
  @@map("trishaw")
}

/// The model's gallery, in display order. `TrishawType.photoFileId` mirrors
/// position 0 so list views can show a cover without joining.
model TrishawTypePhoto {
  id        String      @id @default(cuid())
  typeId    String
  type      TrishawType @relation(fields: [typeId], references: [id], onDelete: Cascade)
  fileId    String      @unique
  file      StoredFile  @relation(fields: [fileId], references: [id], onDelete: Cascade)
  position  Int
  createdAt DateTime    @default(now())

  @@index([typeId, position])
  @@map("trishaw_type_photo")
}

/// Same as `TrishawTypePhoto`, for one trishaw; `Trishaw.photoFileId` is the cover.
model TrishawPhoto {
  id        String     @id @default(cuid())
  trishawId String
  trishaw   Trishaw    @relation(fields: [trishawId], references: [id], onDelete: Cascade)
  fileId    String     @unique
  file      StoredFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  position  Int
  createdAt DateTime   @default(now())

  @@index([trishawId, position])
  @@map("trishaw_photo")
}

/**
 * A damage or flaw on one trishaw. A grounding damage takes the trishaw out of
 * scheduling until an admin clears it; clearing always carries a sentence,
 * because "fixed" and "unjustified" are different stories in the history.
 */
model TrishawDamage {
  id               String      @id @default(cuid())
  trishawId        String
  trishaw          Trishaw     @relation(fields: [trishawId], references: [id], onDelete: Cascade)
  rideId           String?
  ride             Ride?       @relation(fields: [rideId], references: [id], onDelete: SetNull)
  reportedByUserId String?
  reportedBy       User?       @relation("damageReporter", fields: [reportedByUserId], references: [id], onDelete: SetNull)
  description      String      @db.Text
  photoFileId      String?
  photo            StoredFile? @relation("damagePhoto", fields: [photoFileId], references: [id], onDelete: SetNull)
  grounding        Boolean     @default(false)
  reportedAt       DateTime    @default(now())
  clearedAt        DateTime?
  clearedByUserId  String?
  clearedBy        User?       @relation("damageClearer", fields: [clearedByUserId], references: [id], onDelete: SetNull)
  clearNote        String?     @db.Text

  @@index([trishawId, clearedAt])
  @@index([rideId])
  @@map("trishaw_damage")
}

enum TrishawLogType {
  created
  statusChanged
  moved
  note
  damageReported
  damageCleared
}

model TrishawLogEntry {
  id          String         @id @default(cuid())
  trishawId   String
  trishaw     Trishaw        @relation(fields: [trishawId], references: [id], onDelete: Cascade)
  actorUserId String?
  actor       User?          @relation("trishawLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  type        TrishawLogType
  payload     Json?
  createdAt   DateTime       @default(now())

  @@index([trishawId, createdAt])
  @@map("trishaw_log_entry")
}

model Ride {
  id        String       @id @default(cuid())
  chapterId String
  chapter   Organization @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  model     RideModel    @default(event)
  status    RideStatus   @default(scheduled)

  startsAt DateTime
  endsAt   DateTime

  locationName    String? @db.Text
  locationAddress String? @db.Text
  latitude        Float?
  longitude       Float?

  destinationName      String? @db.Text
  destinationAddress   String? @db.Text
  destinationLatitude  Float?
  destinationLongitude Float?

  returnLegOfId String? @unique
  returnLegOf   Ride?   @relation("roundTrip", fields: [returnLegOfId], references: [id], onDelete: SetNull)
  returnLeg     Ride?   @relation("roundTrip")

  cancelledAt        DateTime?
  cancellationReason String?   @db.Text

  trishaws    RideTrishaw[]
  assignments RideAssignment[]
  roster      RideRosterEntry[]
  damages     TrishawDamage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chapterId, startsAt])
  @@index([status, startsAt])
  @@map("ride")
}

/**
 * One trishaw committed to one ride. A request may be for "a single trishaw or
 * multiple trishaws" (lifecycle 1C) and a Multiple Ride Event can involve
 * several at once, so the reservation is a row, not a column on `Ride`.
 * Trailers, wheelchair bikes and transport vehicles are reserved the same way
 * once they have models of their own.
 */
model RideTrishaw {
  id        String   @id @default(cuid())
  rideId    String
  ride      Ride     @relation(fields: [rideId], references: [id], onDelete: Cascade)
  trishawId String
  trishaw   Trishaw  @relation(fields: [trishawId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([rideId, trishawId])
  @@index([trishawId])
  @@map("ride_trishaw")
}

model RideAssignment {
  id        String   @id @default(cuid())
  rideId    String
  ride      Ride     @relation(fields: [rideId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      RideRole @default(pilot)
  createdAt DateTime @default(now())

  @@unique([rideId, userId, role])
  @@index([userId])
  @@index([rideId])
  @@map("ride_assignment")
}

model RideRosterEntry {
  id          String    @id @default(cuid())
  rideId      String
  ride        Ride      @relation(fields: [rideId], references: [id], onDelete: Cascade)
  passengerId String
  passenger   Passenger @relation(fields: [passengerId], references: [id], onDelete: Cascade)
  position    Int       @default(0)
  checkedInAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([rideId, passengerId])
  @@index([passengerId])
  @@index([rideId, position])
  @@map("ride_roster_entry")
}

/// A secret address a calendar app subscribes to (COD-182). Only `key` is kept;
/// the URL also carries an HMAC of it (`lib/crypto/feed-signature`), so a copy
/// of this table alone opens no feed. A new key is a new address, and every
/// app still holding the old one gets a 404 on its next poll.
model CalendarFeed {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  key           String    @unique @db.VarChar(32)
  lastFetchedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("calendar_feed")
}
