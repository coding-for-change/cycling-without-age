generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String               @id
  name                 String               @db.Text
  email                String
  emailVerified        Boolean              @default(false)
  image                String?              @db.Text
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  phoneNumber          String?
  phoneNumberVerified  Boolean?
  role                 String?              @db.Text
  banned               Boolean?             @default(false)
  banReason            String?              @db.Text
  banExpires           DateTime?
  birthDate            DateTime?            @db.Date
  gender               Gender?
  locale               String?              @db.VarChar(5)
  residence            Residence?
  address              String?              @db.Text
  latitude             Float?
  longitude            Float?
  managesOthers        Boolean              @default(false)
  notifyEmail          Boolean              @default(false)
  notifyPush           Boolean              @default(false)
  consentSafetyAt      DateTime?
  consentDataAt        DateTime?
  passkeyPromptedAt    DateTime?
  pilotNextStepsSeenAt DateTime?
  onboardedAt          DateTime?
  createdByUserId      String?
  createdBy            User?                @relation("createdUsers", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdUsers         User[]               @relation("createdUsers")
  claimedAt            DateTime?
  helperName           String?              @db.Text
  helperRelationship   String?              @db.Text
  helperContact        String?              @db.Text
  sessions             Session[]
  accounts             Account[]
  passkeys             Passkey[]
  members              Member[]
  invitations          Invitation[]
  countryAdminOf       CountryAdmin[]
  applications         ChapterApplication[] @relation("applicant")
  decidedApplications  ChapterApplication[] @relation("decider")
  passengers           Passenger[]          @relation("manages")
  passengerProfile     Passenger?           @relation("self")
  activityEvents       ActivityEvent[]      @relation("activitySubject")
  activityActions      ActivityEvent[]      @relation("activityActor")
  eventActions         Event[]              @relation("eventActor")
  notifications        Notification[]       @relation("notificationRecipient")
  devices              Device[]
  rideAssignments      RideAssignment[]

  @@unique([email])
  @@unique([phoneNumber])
  @@index([createdByUserId])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?  @db.Text
  userAgent            String?  @db.Text
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy       String?  @db.Text
  activeOrganizationId String?  @db.Text

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @db.Text
  providerId            String    @db.Text
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String   @db.Text
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier(length: 191)])
  @@map("verification")
}

model Passkey {
  id           String    @id
  name         String?   @db.Text
  publicKey    String    @db.Text
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String    @db.Text
  counter      Int
  deviceType   String    @db.Text
  backedUp     Boolean
  transports   String?   @db.Text
  createdAt    DateTime?
  aaguid       String?   @db.Text

  @@index([userId])
  @@index([credentialID(length: 191)])
  @@map("passkey")
}

model Organization {
  id          String       @id @default(cuid())
  name        String       @db.Text
  slug        String
  logo        String?      @db.Text
  description String?      @db.Text
  createdAt   DateTime     @default(now())
  metadata    String?      @db.Text
  members     Member[]
  invitations Invitation[]

  countryId       String
  country         Country                  @relation(fields: [countryId], references: [id])
  city            String                   @db.Text
  address         String?                  @db.Text
  careHomeName    String?                  @db.Text
  latitude        Float
  longitude       Float
  applications    ChapterApplication[]
  passengers      Passenger[]
  events          ActivityEvent[]
  domainEvents    Event[]
  serviceRadiusKm Int                      @default(10)
  timeZone        String                   @db.VarChar(64)
  settings        ChapterSettings?
  trishaws        Trishaw[]
  rides           Ride[]
  storageSites    StorageLocationChapter[]

  @@unique([slug])
  @@index([countryId])
  @@index([latitude, longitude])
  @@map("organization")
}

model Member {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @db.Text
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String       @db.Text
  role           String?      @db.Text
  status         String       @db.Text
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email(length: 191)])
  @@map("invitation")
}

enum ChapterRole {
  admin
  pilot
  passenger
}

enum ApplicationStatus {
  pending
  approved
  rejected
}

model Country {
  id        String   @id @default(cuid())
  name      String   @db.Text
  code      String   @db.VarChar(2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chapters Organization[]
  admins   CountryAdmin[]

  @@unique([code])
  @@map("country")
}

model CountryAdmin {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  countryId String
  country   Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, countryId])
  @@index([countryId])
  @@map("country_admin")
}

model ChapterSettings {
  chapterId            String       @id
  chapter              Organization @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  notifyOnMemberJoined Boolean      @default(true)
  applicationAlertPush Boolean      @default(true)
  replyToEmail         String?      @db.VarChar(254)
  welcomeNote          String?      @db.Text
  updatedAt            DateTime     @updatedAt

  @@map("chapter_settings")
}

model ChapterApplication {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation("applicant", fields: [userId], references: [id], onDelete: Cascade)
  chapterId       String
  chapter         Organization      @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  role            ChapterRole       @default(pilot)
  status          ApplicationStatus @default(pending)
  message         String?           @db.Text
  decidedByUserId String?
  decidedBy       User?             @relation("decider", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  decidedAt       DateTime?
  decisionNote    String?           @db.Text
  approvalSeenAt  DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([userId, chapterId])
  @@index([chapterId, status])
  @@index([decidedByUserId])
  @@map("chapter_application")
}

enum Gender {
  female
  male
  other
}

enum Residence {
  careHome
  home
}

model Passenger {
  id              String       @id @default(cuid())
  chapterId       String
  chapter         Organization @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  managedByUserId String
  managedBy       User         @relation("manages", fields: [managedByUserId], references: [id], onDelete: Cascade)
  userId          String?      @unique
  user            User?        @relation("self", fields: [userId], references: [id], onDelete: SetNull)

  firstName String   @db.Text
  lastName  String   @db.Text
  birthDate DateTime @db.Date
  gender    Gender

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rideRoster RideRosterEntry[]

  @@index([chapterId])
  @@index([managedByUserId])
  @@map("passenger")
}

enum ActivityType {
  applicationSubmitted
  applicationApproved
  applicationRejected
  roleGranted
  roleRevoked
  memberRemoved
  emailSent
  countryAdminAppointed
  countryAdminRemoved
  accountCreated
  invited
  accountClaimed
  chapterCreated
  chapterUpdated
  chapterDeleted
  countryDeleted
}

model ActivityEvent {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation("activitySubject", fields: [userId], references: [id], onDelete: Cascade)
  actorUserId String?
  actor       User?         @relation("activityActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  chapterId   String?
  chapter     Organization? @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  type        ActivityType
  payload     Json?
  createdAt   DateTime      @default(now())

  @@index([userId, createdAt])
  @@index([chapterId, createdAt])
  @@map("activity_event")
}

model Event {
  id          String        @id @default(cuid())
  type        String
  payload     Json
  actorUserId String?
  actor       User?         @relation("eventActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  chapterId   String?
  chapter     Organization? @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  processedAt DateTime?

  notifications Notification[]

  @@index([processedAt, createdAt])
  @@index([actorUserId])
  @@index([chapterId, createdAt])
  @@map("event")
}

model Notification {
  id              String    @id @default(cuid())
  recipientUserId String
  recipient       User      @relation("notificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  eventId         String
  event           Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category        String    @db.VarChar(64)
  payload         Json
  href            String    @db.Text
  collapseKey     String?
  seenAt          DateTime?
  readAt          DateTime?
  createdAt       DateTime  @default(now())

  deliveries Delivery[]

  @@unique([eventId, recipientUserId])
  @@index([recipientUserId, createdAt])
  @@index([recipientUserId, seenAt])
  @@map("notification")
}

enum DeliveryChannel {
  email
  push
}

enum DeliveryStatus {
  pending
  sending
  sent
  failed
  skipped
}

model Delivery {
  id                String          @id @default(cuid())
  notificationId    String
  notification      Notification    @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  channel           DeliveryChannel
  status            DeliveryStatus  @default(pending)
  attempts          Int             @default(0)
  providerMessageId String?
  lastError         String?         @db.Text
  sentAt            DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([notificationId, channel])
  @@index([status, createdAt])
  @@map("delivery")
}

enum DevicePlatform {
  ios
  android
}

model Device {
  id         String         @id @default(cuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform   DevicePlatform
  token      String         @db.VarChar(512)
  lastSeenAt DateTime       @default(now())
  createdAt  DateTime       @default(now())

  @@unique([token])
  @@index([userId])
  @@index([lastSeenAt])
  @@map("device")
}

enum RideModel {
  event
  pleasure
  functional
}

enum RideStatus {
  scheduled
  cancelled
  completed
}

enum RideRole {
  pilot
}

enum TrishawStatus {
  active
  maintenance
  retired
}

/**
 * Where trishaws are kept. A care home or depot can serve more than one chapter
 * — the equipment lives at the place, not at the chapter — so the link to
 * chapters is a join table rather than a column. This is separate from a
 * trishaw's owning chapter: who bought it and who reports on it does not change
 * because it is parked somewhere shared.
 */
model StorageLocation {
  id        String  @id @default(cuid())
  name      String  @db.Text
  address   String? @db.Text
  latitude  Float?
  longitude Float?

  chapters  StorageLocationChapter[]
  trishaws  Trishaw[]
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt

  @@map("storage_location")
}

model StorageLocationChapter {
  id                String          @id @default(cuid())
  storageLocationId String
  storageLocation   StorageLocation @relation(fields: [storageLocationId], references: [id], onDelete: Cascade)
  chapterId         String
  chapter           Organization    @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now())

  @@unique([storageLocationId, chapterId])
  @@index([chapterId])
  @@map("storage_location_chapter")
}

/**
 * A trishaw model — "Triobike Taxi", "VeloPlus". A table rather than an enum
 * because it is a manufacturer's catalogue that grows: CWA's own roles
 * reference writes the set open-endedly, "(Triobike Taxi, VeloPlus, …)". A
 * table rather than free text because three requirements *compare* types —
 * pilot qualification is per trishaw type (`03-roles.md`), a client chooses a
 * bike type when booking, and the negotiation loop offers another type when one
 * is unavailable (`07-functional-ride-user-stories.md`). None of those survive
 * an unconstrained string.
 * Whether a type also fixes the seat count and wheelchair access is still open
 * with CWA; both become columns here when answered, which is the point of a
 * table.
 */
model TrishawType {
  id        String    @id @default(cuid())
  name      String    @db.VarChar(80)
  trishaws  Trishaw[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([name])
  @@map("trishaw_type")
}

model Trishaw {
  id        String        @id @default(cuid())
  chapterId String
  chapter   Organization  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  name      String        @db.Text
  typeId    String?
  type      TrishawType?  @relation(fields: [typeId], references: [id], onDelete: SetNull)
  seats     Int           @default(2)
  status    TrishawStatus @default(active)

  /// Null means the bike sits at its owning chapter's own address; a row here
  /// is a shared site, and every chapter linked to it may schedule the bike.
  storageLocationId String?
  storageLocation   StorageLocation? @relation(fields: [storageLocationId], references: [id], onDelete: SetNull)

  rides     RideTrishaw[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([chapterId, status])
  @@index([storageLocationId])
  @@index([typeId])
  @@map("trishaw")
}

model Ride {
  id        String       @id @default(cuid())
  chapterId String
  chapter   Organization @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  model     RideModel    @default(event)
  status    RideStatus   @default(scheduled)

  startsAt DateTime
  endsAt   DateTime

  locationName    String? @db.Text
  locationAddress String? @db.Text
  latitude        Float?
  longitude       Float?

  destinationName      String? @db.Text
  destinationAddress   String? @db.Text
  destinationLatitude  Float?
  destinationLongitude Float?

  returnLegOfId String? @unique
  returnLegOf   Ride?   @relation("roundTrip", fields: [returnLegOfId], references: [id], onDelete: SetNull)
  returnLeg     Ride?   @relation("roundTrip")

  cancelledAt        DateTime?
  cancellationReason String?   @db.Text

  trishaws    RideTrishaw[]
  assignments RideAssignment[]
  roster      RideRosterEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chapterId, startsAt])
  @@index([status, startsAt])
  @@map("ride")
}

/**
 * One trishaw committed to one ride. A request may be for "a single trishaw or
 * multiple trishaws" (lifecycle 1C) and a Multiple Ride Event can involve
 * several at once, so the reservation is a row, not a column on `Ride`.
 * Trailers, wheelchair bikes and transport vehicles are reserved the same way
 * once they have models of their own.
 */
model RideTrishaw {
  id        String   @id @default(cuid())
  rideId    String
  ride      Ride     @relation(fields: [rideId], references: [id], onDelete: Cascade)
  trishawId String
  trishaw   Trishaw  @relation(fields: [trishawId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([rideId, trishawId])
  @@index([trishawId])
  @@map("ride_trishaw")
}

model RideAssignment {
  id        String   @id @default(cuid())
  rideId    String
  ride      Ride     @relation(fields: [rideId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      RideRole @default(pilot)
  createdAt DateTime @default(now())

  @@unique([rideId, userId, role])
  @@index([userId])
  @@index([rideId])
  @@map("ride_assignment")
}

model RideRosterEntry {
  id          String    @id @default(cuid())
  rideId      String
  ride        Ride      @relation(fields: [rideId], references: [id], onDelete: Cascade)
  passengerId String
  passenger   Passenger @relation(fields: [passengerId], references: [id], onDelete: Cascade)
  position    Int       @default(0)
  checkedInAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([rideId, passengerId])
  @@index([passengerId])
  @@index([rideId, position])
  @@map("ride_roster_entry")
}
