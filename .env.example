# Database (matches docker-compose.yml defaults)
DATABASE_URL="mysql://root:cwa@localhost:3307/cwa_dev"

# Local S3 emulator (Minio, matches docker-compose.yml defaults)
S3_ENDPOINT="http://localhost:9002"
S3_REGION="eu-central-1"
S3_BUCKET="cwa-local"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"

# Local SMTP catcher (Mailpit, UI at http://localhost:8026)
SMTP_HOST="localhost"
SMTP_PORT="1026"
