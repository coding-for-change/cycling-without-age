# Database (matches docker-compose.yml defaults)
DATABASE_URL="mysql://root:cwa@localhost:3307/cwa_dev"

# Local S3 emulator (Minio, matches docker-compose.yml defaults)
S3_ENDPOINT="http://localhost:9002"
S3_REGION="eu-central-1"
S3_BUCKET="cwa-local"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"

# Resend — used in production only; dev mail always goes to Mailpit (see below)
RESEND_API_KEY=""
EMAIL_FROM="onboarding@resend.dev"

# Mailpit web UI, where dev mail (incl. sign-in OTPs) lands. Matches docker-compose.yml.
# Set to "" to send real mail through Resend outside production.
MAILPIT_URL="http://localhost:8026"

# better-auth signing secret (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET="change-me"

# Public base URL of the app (better-auth callbacks)
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth credentials (Google sign-in is disabled while empty)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
