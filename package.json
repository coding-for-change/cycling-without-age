{
  "name": "cycling-without-age",
  "version": "0.1.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint && node scripts/check-brand-tokens.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "db:push": "dotenv -e .env.local -- prisma db push",
    "cap:sync": "cap sync",
    "cap:assets": "capacitor-assets generate --ios --android",
    "cap:ios": "cap run ios",
    "cap:android": "cap run android",
    "cap:ios:dev": "CAP_SERVER_URL=http://localhost:3000 cap run ios",
    "cap:android:dev": "CAP_SERVER_URL=http://10.0.2.2:3000 cap run android",
    "prepare": "husky",
    "check:brand": "node scripts/check-brand-tokens.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@better-auth/passkey": "^1.7.2",
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/splash-screen": "^8.0.2",
    "@formatjs/intl-localematcher": "^0.8.13",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/client": "^6.19.2",
    "@react-email/components": "^1.0.12",
    "@shadcn/react": "^0.3.0",
    "better-auth": "^1.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.8.0",
    "negotiator": "^1.1.0",
    "next": "^16.2.6",
    "next-themes": "^0.4.6",
    "prisma": "^6.19.2",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.86.0",
    "react-resizable-panels": "^4.12.3",
    "recharts": "^3.8.0",
    "resend": "^6.25.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "@tailwindcss/postcss": "^4",
    "@types/negotiator": "^0.6.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "^6.0.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,json,css,md,yml,yaml}": "prettier --write"
  }
}
